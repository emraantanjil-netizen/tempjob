{
  "colors": {
    "primary": {
      "DEFAULT": "#004ac6",
      "container": "#2563EB",
      "on": "#FFFFFF"
    },
    "secondary": {
      "DEFAULT": "#006C49",
      "container": "#6CF8BB",
      "on": "#00714D"
    },
    "tertiary": {
      "DEFAULT": "#784B00",
      "fixed": "#FFDDB8",
      "on": "#2A1700"
    },
    "error": {
      "DEFAULT": "#BA1A1A",
      "container": "#FFDAD6",
      "on": "#FFFFFF"
    },
    "surface": {
      "DEFAULT": "#F8F9FF",
      "container_lowest": "#FFFFFF",
      "container_low": "#EFF4FF",
      "container_high": "#DEE9FC",
      "container_highest": "#D9E3F6"
    },
    "text": {
      "on_surface": "#121C2A",
      "on_surface_variant": "#434655"
    },
    "outline": {
      "variant": "#C3C6D7"
    }
  },
  "typography": {
    "fonts": {
      "headlines": {
        "family": "Manrope",
        "weights": [600, 700, 800]
      },
      "body": {
        "family": "Inter",
        "weights": [400, 500, 600]
      }
    },
    "scales": {
      "h1": {
        "size": "30px",
        "weight": 700,
        "font": "Manrope",
        "lineHeight": "36px",
        "letterSpacing": "-0.015em"
      },
      "h3": {
        "size": "18px",
        "weight": 700,
        "font": "Manrope",
        "lineHeight": "24px",
        "letterSpacing": "-0.015em"
      },
      "label": {
        "size": "14px",
        "weight": 600,
        "font": "Inter",
        "lineHeight": "20px"
      },
      "body": {
        "size": "14px",
        "weight": 400,
        "font": "Inter",
        "lineHeight": "21px"
      },
      "small": {
        "size": "12px",
        "weight": 400,
        "font": "Inter",
        "lineHeight": "16px"
      },
      "caption": {
        "size": "10px",
        "weight": 700,
        "font": "Inter",
        "lineHeight": "12px",
        "letterSpacing": "0.025em",
        "textTransform": "uppercase"
      }
    }
  },
  "spacing": {
    "baseUnit": 8,
    "tokens": {
      "space_1": "8px",
      "space_2": "16px",
      "space_3": "24px",
      "space_4": "32px",
      "space_5": "40px",
      "space_6": "48px"
    },
    "responsive": {
      "mobile": "16px horizontal padding",
      "md_breakpoint": "768px (2-column grid)",
      "lg_breakpoint": "1024px (8-col content + 4-col sidebar)"
    }
  },
  "components": {
    "button": {
      "primary": {
        "height": "44px",
        "paddingX": "40px",
        "paddingY": "10px",
        "borderRadius": "12px",
        "background": "gradient from-primary (#004AC6) to-primary-container (#2563EB)",
        "textColor": "on-primary (#FFFFFF)",
        "fontWeight": 700,
        "shadow": "shadow-lg shadow-primary/20",
        "hover": "scale(1.02)",
        "active": "scale(0.95)",
        "transition": "150-200ms"
      },
      "secondary": {
        "height": "44px",
        "paddingX": "24px",
        "paddingY": "10px",
        "borderRadius": "12px",
        "background": "transparent",
        "textColor": "on-surface-variant (#434655)",
        "fontWeight": 600,
        "border": "none",
        "hover": "bg-surface-container-high (#DEE9FC)",
        "transition": "150ms"
      }
    },
    "input": {
      "text": {
        "height": "44px",
        "paddingX": "16px",
        "paddingY": "12px",
        "borderRadius": "12px",
        "background": "surface-container-low (#EFF4FF)",
        "border": "none",
        "ring": "ring-1 ring-outline-variant/20 (#C3C6D7)",
        "focusRing": "ring-2 ring-primary/40 (blue glow)",
        "textColor": "on-surface (#121C2A)",
        "fontSize": "14px",
        "placeholder": "on-surface-variant (#434655)",
        "transition": "all 150ms"
      },
      "textarea": {
        "minHeight": "100px",
        "same_as_text": true,
        "font": "Inter 400 14px"
      }
    },
    "card": {
      "borderRadius": "12px",
      "background": "surface-container-lowest (#FFFFFF)",
      "padding": "32px or 24px",
      "shadow": "shadow-sm shadow-blue-900/5",
      "spacing": "space-y-6 (24px vertical gaps)"
    },
    "badge": {
      "salary_badge": {
        "background": "secondary-container (#6CF8BB)",
        "textColor": "on-secondary-container (#00714D)",
        "fontSize": "12px",
        "fontWeight": 700,
        "padding": "4px 8px",
        "borderRadius": "8px"
      },
      "status_approved": {
        "background": "secondary-container (#6CF8BB)",
        "textColor": "on-secondary-container (#00714D)"
      },
      "status_pending": {
        "background": "tertiary-fixed (#FFDDB8)",
        "textColor": "on-tertiary-fixed (#2A1700)"
      },
      "status_rejected": {
        "background": "error-container",
        "textColor": "error (#BA1A1A)"
      },
      "required": {
        "fontSize": "10px",
        "fontWeight": 700,
        "textTransform": "uppercase",
        "letterSpacing": "0.025em",
        "color": "primary (#004AC6)"
      }
    },
    "navigation": {
      "header": {
        "height": "56px",
        "position": "sticky top-0",
        "background": "surface with backdrop-blur-xl",
        "padding": "12px 16px",
        "zIndex": 40
      },
      "bottom_bar": {
        "height": "56px",
        "position": "fixed bottom-0",
        "background": "surface (#F8F9FF)",
        "display": "5 tabs",
        "responsive": "md:hidden (mobile only)",
        "active_tab": {
          "color": "primary (#004AC6)",
          "background": "primary/10",
          "borderRadius": "24px",
          "scale": "animation on press"
        },
        "inactive_tab": {
          "color": "on-surface-variant (#434655)",
          "hover": "text-primary"
        }
      }
    },
    "icon": {
      "default_size": "24px",
      "family": "Material Symbols Outlined",
      "fill": "auto (filled when active, outlined when inactive)"
    }
  },
  "screens": {
    "mobile": {
      "width": "375px",
      "height": "812px",
      "orientation": "portrait",
      "safeArea": "top-6 bottom-16"
    },
    "tablet": {
      "width": "768px",
      "breakpoint": "md"
    },
    "desktop": {
      "width": "1024px+",
      "breakpoint": "lg",
      "maxContentWidth": "56rem (4xl)"
    }
  },
  "interactions": {
    "transitions": {
      "fast": "150ms ease-in-out",
      "normal": "200ms ease-in-out",
      "slow": "300ms ease-in-out"
    },
    "button_states": {
      "default": "no transform",
      "hover": "scale(1.02)",
      "active": "scale(0.95)",
      "disabled": "opacity-50"
    },
    "focus_ring": {
      "color": "primary (#004AC6)",
      "width": "2px",
      "offset": "2px"
    }
  },
  "accessibility": {
    "minTouchTarget": "44px",
    "minContrast": "4.5:1 (WCAG AA)",
    "semanticHTML": true,
    "focusVisible": true,
    "ariaLabels": "required for icon buttons"
  },
  "tailwind_config": {
    "extend": {
      "colors": {
        "primary": "#004ac6",
        "primary-container": "#2563EB",
        "on-primary": "#FFFFFF",
        "secondary": "#006C49",
        "secondary-container": "#6CF8BB",
        "on-secondary-container": "#00714D",
        "surface": "#F8F9FF",
        "surface-container-lowest": "#FFFFFF",
        "surface-container-low": "#EFF4FF",
        "surface-container-high": "#DEE9FC",
        "surface-container-highest": "#D9E3F6",
        "on-surface": "#121C2A",
        "on-surface-variant": "#434655",
        "outline-variant": "#C3C6D7"
      },
      "fontFamily": {
        "manrope": ["Manrope", "sans-serif"],
        "inter": ["Inter", "sans-serif"]
      },
      "spacing": {
        "0.5": "4px",
        "1": "8px",
        "2": "16px",
        "3": "24px",
        "4": "32px"
      }
    }
  },
  "google_fonts": {
    "imports": [
      "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
      "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap",
      "https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
    ]
  },
